# Copy this file to .env and put your key in .env only. Never commit .env.
GEMINI_API_KEY=gemini_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MIN_INTERVAL_SECONDS=4

# Configure rates for YOUR model and billing tier, per 1 million tokens (USD).
# Leave blank if unknown; submission packaging then requests that you configure them.
# For an applicable free tier, set both to 0. For paid pricing consult:
# https://ai.google.dev/gemini-api/docs/pricing
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
